{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",

    "read": "allow",
    "bash": {
      "*": "ask",
      "rm *": "deny",
      "code *": "deny",
      "grep *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "tail *": "allow",
      "head *": "allow",
      "git log *": "allow",
      "echo *": "allow",
      "git status *": "allow",
      "file *": "allow"
    },
    "edit": {
      "*": "deny",
      "src/**/*": "allow",
      "package.json": "ask",
      ".gitignore": "ask",
      "vite.config.ts": "ask",
      "pnpm-workspace.yaml": "ask"
    },
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "todowrite": "allow",
    "question": "allow"
  }
}
