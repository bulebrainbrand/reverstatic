{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "ask",
    
    "read":"allow",
    "bash":{
       "*":"ask",
       "rm *":"deny",
       "code *":"deny",
       "grep *":"allow",
       "find *":"allow",
       "ls *":"allow"
    },
    "edit":{
        "*":"deny",
        "src/**/*":"allow",
        "package.json":"ask",
        "vite.config.json":"ask",
        "pnpm-workspace.yaml":"ask"
    }
  }
}