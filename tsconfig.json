{
    "compilerOptions": {
        "noEmit": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "target": "esnext",
        "isolatedModules": true,
        "skipLibCheck": true,
        "verbatimModuleSyntax": true
    },
    "include": [
        "./src/**/*.ts"
    ]
}